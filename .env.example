
# Port pour le serveur backend
PORT=3000

# WooCommerce API
WOO_API_URL=https://example.com
WOO_CONSUMER_KEY=your_woo_consumer_key
WOO_CONSUMER_SECRET=your_woo_consumer_secret

# WordPress API
WP_USERNAME=your_wp_username
WP_PASSWORD=your_wp_password

# Mailjet API
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAIL_FROM=your_sender_email@example.com

# Admin credentials for the backend
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
